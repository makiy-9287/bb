# ── DeepSeek ──────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ── Reasoning ─────────────────────────────────────────────
# Literal request is "medium"; DeepSeek maps medium → high internally.
# Options: low | medium | high | max
REASONING_EFFORT=high
USE_THINKING=true

# ── Telegram ──────────────────────────────────────────────
# Admin chat — receives commands + auth
TELEGRAM_CHAT_ID=5530953384

# Signal recipients (comma-separated). Admin auto-included.
TELEGRAM_BROADCAST_IDS=8950070985

